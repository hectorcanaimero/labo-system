# ============================================================================
# labo-system — variables de entorno
# Backend: InsForge self-hosted (ADR-11) — https://insforge.rvlaboratorio.com
# ============================================================================

# ─── InsForge ───────────────────────────────────────────────────────────────

# URL pública de la instancia InsForge en el VPS.
# La usa el server (postgres.js / llamadas admin) y el cliente Next.js.
INSFORGE_URL=https://insforge.rvlaboratorio.com
NEXT_PUBLIC_INSFORGE_URL=https://insforge.rvlaboratorio.com

# Anon key (diseñada para exponerse en el browser; los permisos reales los da
# RLS/policies). Se obtiene del dashboard o de GET /api/metadata/anon-key.
INSFORGE_ANON_KEY=

# Anon key expuesta al cliente Next.js. OJO: es una variable distinta de
# INSFORGE_ANON_KEY — `apps/web/app/providers.tsx` lee específicamente
# NEXT_PUBLIC_INSFORGE_ANON_KEY y lanza un 500 en la primera render si falta.
# Normalmente lleva el mismo valor que INSFORGE_ANON_KEY.
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# API key admin de InsForge (ik_...). Server-side SOLAMENTE — nunca exponer al
# browser ni commitear. La usan getAdminDb() (login/audit, invitaciones, cron,
# export) para operaciones pre-auth o de fondo. No vive en el repo.
INSFORGE_API_KEY=

# Conexión Postgres directa para packages/db (driver postgres.js).
# La DB no queda expuesta públicamente: alcanzar solo desde el VPS o por túnel
# SSH. Ver docs/deploy/insforge-vps.md § Seguridad.
DATABASE_URL=postgresql://usuario:password@host:5432/insforge

# Secreto compartido para autenticar llamadas a endpoints de cron (F4).
# Generar con: openssl rand -hex 32
CRON_SECRET=

# Máxima variación permitida al persistir tasa desde scraper (0.5 = ±50%).
# Rechaza outliers y protege ante HTML corrupto/MITM. Default 0.5.
BCV_MAX_CHANGE_RATIO=0.5

# ─── Almacenamiento local de archivos (packages/lib/storage-local.ts) ───────

# Secreto para firmar las URLs de archivos. Mínimo 32 caracteres o el módulo
# de storage lanza. Generar con: openssl rand -hex 32
STORAGE_SIGNING_SECRET=

# Directorio donde se guardan los archivos subidos.
# Default: <cwd>/.storage. En Docker debe apuntar a un volumen persistente
# (ver docker-compose.staged.yml) o se pierden en cada redeploy.
STORAGE_ROOT=

# ─── Email (Resend) ─────────────────────────────────────────────────────────

# API key de Resend (re_...). Server-side SOLAMENTE. Con ella el envío de
# resultados por email, las invitaciones y las alertas del cron salen de
# verdad. Sin ella el botón "Email" de resultados cae a un mailto: y las
# invitaciones fallan con EMAIL_NO_DISPONIBLE.
RESEND_API_KEY=

# Remitente. El dominio debe estar verificado en Resend.
# Default: "Rv Laboratorio <noreply@rvlaboratorio.com>".
EMAIL_FROM=

# ─── Opcionales ─────────────────────────────────────────────────────────────

# URL pública de la app; se usa para armar los links de invitación y de envío
# de resultados. Sin ella se infiere del request entrante.
NEXT_PUBLIC_APP_URL=

# Observaciones asistidas por IA (Gemini). Ambas deben ser "true" para
# habilitar la feature; GEMINI_API_KEY solo hace falta si está activa.
AI_OBSERVACIONES_ENABLED=false
NEXT_PUBLIC_AI_OBSERVACIONES_ENABLED=false
GEMINI_API_KEY=
