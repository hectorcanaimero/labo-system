# ============================================================================
# labo-system — variables de entorno
# Backend: InsForge self-hosted (ADR-11) — https://insforge.rvlaboratorio.com
# ============================================================================

# ─── InsForge ───────────────────────────────────────────────────────────────

# URL pública de la instancia InsForge en el VPS.
# La usa el server (postgres.js / llamadas admin) y el cliente Next.js.
INSFORGE_URL=https://insforge.rvlaboratorio.com
NEXT_PUBLIC_INSFORGE_URL=https://insforge.rvlaboratorio.com

# Anon key (diseñada para exponerse en el browser; los permisos reales los da
# RLS/policies). Se obtiene del dashboard o de GET /api/metadata/anon-key.
INSFORGE_ANON_KEY=

# API key admin de InsForge (ik_...). Server-side SOLAMENTE — nunca exponer al
# browser ni commitear. La usan getAdminDb() (login/audit, invitaciones, cron,
# export) para operaciones pre-auth o de fondo. No vive en el repo.
INSFORGE_API_KEY=

# Conexión Postgres directa para packages/db (driver postgres.js).
# La DB no queda expuesta públicamente: alcanzar solo desde el VPS o por túnel
# SSH. Ver docs/deploy/insforge-vps.md § Seguridad.
DATABASE_URL=postgresql://usuario:password@host:5432/insforge

# Secreto compartido para autenticar llamadas a endpoints de cron (F4).
# Generar con: openssl rand -hex 32
CRON_SECRET=

# Máxima variación permitida al persistir tasa desde scraper (0.5 = ±50%).
# Rechaza outliers y protege ante HTML corrupto/MITM. Default 0.5.
BCV_MAX_CHANGE_RATIO=0.5
