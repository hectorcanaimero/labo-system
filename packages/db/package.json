{
  "name": "@labo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./client.ts",
  "types": "./client.ts",
  "exports": {
    ".": "./client.ts",
    "./client": "./client.ts",
    "./repos/*": "./repos/*.ts",
    "./schema.sql": "./schema.sql",
    "./migrations/*": "./migrations/*"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f migrations/0001_init.sql"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^8.57.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
