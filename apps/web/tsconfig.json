{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@labo/db": [
        "../../packages/db"
      ],
      "@labo/db/*": [
        "../../packages/db/*"
      ],
      "@labo/lib": [
        "../../packages/lib"
      ],
      "@labo/lib/*": [
        "../../packages/lib/*"
      ],
      "@labo/ui": [
        "../../packages/ui"
      ],
      "@labo/ui/*": [
        "../../packages/ui/*"
      ],
      "@labo/convex": [
        "../../packages/convex"
      ],
      "@labo/convex/*": [
        "../../packages/convex/*"
      ],
      "@labo/pdf": [
        "../../packages/pdf/src"
      ],
      "@labo/pdf/*": [
        "../../packages/pdf/src/*"
      ]
    },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist"
  ]
}
